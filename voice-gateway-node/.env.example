# =============================================================================
# Voice Gateway Node.js Environment Variables (.env.example)
# =============================================================================
PORT=3000
SPRING_BACKEND_URL=http://localhost:8080
INTERNAL_SERVICE_KEY=intern-voice-gateway-internal-secret-token-key-2026

# Provider Selection: 'real' | 'mock'
STT_PROVIDER=mock
TTS_PROVIDER=mock
LLM_PROVIDER=mock

# External AI Provider API Keys (Leave blank or unset to automatically use Mock Providers)
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
